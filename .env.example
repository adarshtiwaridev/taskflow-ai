# Environment Configuration
NODE_ENV=production
PORT=5000
API_PORT=5000
WEB_URL=https://taskflow-ai-murex.vercel.app
CORS_ORIGIN=https://taskflow-ai-murex.vercel.app

# PostgreSQL Database (Prisma)
# On Render: Use the internal or external database URL provided by Render
DATABASE_URL=postgresql://taskflow:taskflow_dev_password@localhost:5432/taskflow?schema=public

# Redis Connection (Pub/Sub adapter for Socket.io)
# On Render: Use Redis or leave empty to use in-memory pub/sub fallback
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters

# AI Task Breakdown (OpenAI or compatible provider)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Frontend Environment Variables (Vite - on Vercel)
VITE_API_URL=https://your-render-backend.onrender.com
VITE_WS_URL=https://your-render-backend.onrender.com
