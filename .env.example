# Environment Configuration
NODE_ENV=development
API_PORT=5000
PORT=5000
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://taskflow:taskflow_dev_password@localhost:5432/taskflow?schema=public

# Redis Connection (Pub/Sub adapter for Socket.io)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters

# AI Task Breakdown (OpenAI or compatible provider)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:5000
VITE_WS_URL=http://localhost:5000
